# ──────────────────────────────────────────────────────────────────
# Construct v6 — environment variables
# Copy to .env (gitignored) and fill in.
# ──────────────────────────────────────────────────────────────────

# Postgres (matches docker-compose)
POSTGRES_USER=construct
POSTGRES_PASSWORD=construct_dev_change_me
POSTGRES_DB=construct_v6
# Используем 5433 чтобы не конфликтовать с локальным Postgres v5.2.1 на 5432
POSTGRES_PORT=5433

# Prisma connection string (used by apps/api and packages/db)
DATABASE_URL=postgresql://construct:construct_dev_change_me@127.0.0.1:5433/construct_v6?schema=public

# API
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development

# JWT
JWT_SECRET=replace_with_32+_chars_random_string
JWT_EXPIRES_IN=30d

# Telegram
# Bot username (без @), используется для Login Widget
TELEGRAM_BOT_USERNAME=YourBotUsername
# Bot token (из @BotFather). НИКОГДА не коммитить.
TELEGRAM_BOT_TOKEN=
# Comma-separated allowlist of Telegram user IDs (e.g. 12345,67890)
TELEGRAM_ALLOWED_IDS=

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourBotUsername

# Uploads
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=10
