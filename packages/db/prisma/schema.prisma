// Construct v6 — финансовый учёт для малого бизнеса / самозанятых.
// Single-currency (RUB), workspace-scoped, soft-delete pattern, audit log.
//
// Этот файл описывает только хранилище. Доменная логика (правила сторно,
// WAVG, finalize заказа) живёт в apps/api/src/domain — здесь только структура,
// чтобы её можно было читать любым ORM-инструментом.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Users & Workspaces ─────────────────────────────

model User {
  id         String   @id @default(cuid())
  telegramId BigInt   @unique
  username   String?
  firstName  String?
  lastName   String?
  photoUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ownedWorkspaces       Workspace[]             @relation("WorkspaceOwner")
  workspaceMemberships  WorkspaceMember[]
  createdTransactions   Transaction[]           @relation("TransactionCreatedBy")
  auditLogs             AuditLog[]
  importBatches         ImportBatch[]
  createdTransfers      Transfer[]              @relation("TransferCreatedBy")
  createdStockMovements StockMovement[]         @relation("StockMovementCreatedBy")
  balanceChecks         AccountBalanceCheck[]   @relation("BalanceCheckCreatedBy")
  createdStockLots      StockLot[]              @relation("StockLotCreatedBy")
  createdOrderReturns   OrderReturn[]           @relation("OrderReturnCreatedBy")
  createdIntegrations   IntegrationConnection[] @relation("IntegrationCreatedBy")
  createdWbReceipts     WbReceipt[]             @relation("WbReceiptCreatedBy")
  createdRecurring      RecurringPayment[]      @relation("RecurringCreatedBy")
  createdPlanned        PlannedPayment[]        @relation("PlannedCreatedBy")
  createdBudgets        Budget[]                @relation("BudgetCreatedBy")
}

model Workspace {
  id        String    @id @default(cuid())
  name      String
  ownerId   String
  /// ₽ единственная валюта пока — поле опционально на будущее.
  currency  String    @default("RUB")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner             User                    @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members           WorkspaceMember[]
  accounts          Account[]
  categories        Category[]
  counterparties    Counterparty[]
  transactions      Transaction[]
  importBatches     ImportBatch[]
  rules             Rule[]
  auditLogs         AuditLog[]
  orders            Order[]
  warehouseItems    WarehouseItem[]
  purchases         Purchase[]
  attachments       Attachment[]
  paymentSchedule   PaymentScheduleEntry[]
  transfers         Transfer[]
  stockMovements    StockMovement[]
  balanceChecks     AccountBalanceCheck[]
  stockLots         StockLot[]
  lotConsumptions   LotConsumption[]
  orderReturns      OrderReturn[]
  integrations      IntegrationConnection[]
  bankLines         BankStatementLine[]
  wbReceipts        WbReceipt[]
  recurringPayments RecurringPayment[]
  plannedPayments   PlannedPayment[]
  budgets           Budget[]

  @@index([ownerId])
  @@index([deletedAt])
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        Role     @default(OWNER)
  joinedAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// ───────────────────────────── Accounts ─────────────────────────────

model Account {
  id             String       @id @default(cuid())
  workspaceId    String
  name           String
  type           AccountType
  /// Бухгалтерский класс: OPERATING — рабочий счёт бизнеса; TRANSIT — транзитный
  /// (эквайринг, маркетплейс, кошелёк-посредник); PERSONAL — личный счёт физика.
  /// Все три класса считаются «нашими» деньгами: в консолидированном cashflow они
  /// сливаются в один пул, и переводы между ними не создают приток/отток.
  class          AccountClass @default(OPERATING)
  openingBalance Decimal      @default(0) @db.Decimal(14, 2)
  isArchived     Boolean      @default(false)
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  workspace         Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  transfersFrom     Transfer[]              @relation("TransferFrom")
  transfersTo       Transfer[]              @relation("TransferTo")
  balanceChecks     AccountBalanceCheck[]
  stockLots         StockLot[]              @relation("StockLotAccount")
  integrations      IntegrationConnection[]
  wbReceipts        WbReceipt[]             @relation("WbReceiptAccount")
  recurringPayments RecurringPayment[]      @relation("RecurringAccount")
  plannedPayments   PlannedPayment[]        @relation("PlannedAccount")

  @@index([workspaceId, isArchived])
  @@index([workspaceId, deletedAt])
}

enum AccountType {
  CASH
  BANK
  OTHER
}

enum AccountClass {
  OPERATING // рабочий счёт бизнеса (касса, основной р/с)
  TRANSIT // транзитный: эквайринг, маркетплейс, платёжный посредник
  PERSONAL // личный счёт физика, через который проходят деньги бизнеса
}

// ───────────────────────────── Categories ─────────────────────────────
//
// Иерархия категорий (до 2 уровней) — это UX-удобство.
// `bucket` — бухгалтерская группа, по которой строятся отчёты P&L.
// Иерархия и бакет независимы: подкатегория «Реклама» (родитель «Продвижение»)
// может иметь bucket=VARIABLE, а её сестра «Аренда офиса» — bucket=FIXED.

model Category {
  id          String         @id @default(cuid())
  workspaceId String
  name        String
  kind        CategoryKind
  bucket      CategoryBucket @default(OTHER)
  parentId    String?
  isFixedCost Boolean        @default(false) // legacy флаг под break-even
  isArchived  Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent            Category?          @relation("CategoryTree", fields: [parentId], references: [id])
  children          Category[]         @relation("CategoryTree")
  transactions      Transaction[]
  recurringPayments RecurringPayment[] @relation("RecurringCategory")
  plannedPayments   PlannedPayment[]   @relation("PlannedCategory")
  budgets           Budget[]           @relation("BudgetCategory")

  @@index([workspaceId, kind, parentId])
  @@index([workspaceId, bucket])
  @@index([workspaceId, deletedAt])
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum CategoryBucket {
  REVENUE // выручка от продаж (учитывается в P&L "доход")
  COGS // себестоимость проданных (учитывается в P&L "себестоимость")
  PURCHASES // закупки товара на склад (cash-basis: расход в момент закупки; не входит в grossProfit)
  FIXED // постоянные издержки (аренда, подписки, лицензии)
  VARIABLE // переменные коммерческие (реклама, доставка, комиссии)
  TAX // налоги, страховые
  CAPITAL // вложения / изъятия собственника — НЕ в P&L, только в Cash flow
  OTHER
}

// ───────────────────────────── Counterparties ─────────────────────────────
//
// Единая таблица контрагентов с дискриминатором `role`.
// Клиент, поставщик и сотрудник — это **роли** одного и того же лица.
// Опциональные поля заполняются в зависимости от роли:
//   CLIENT   → source, leadStatus
//   SUPPLIER → inn
//   EMPLOYEE → position, payRate
//
// Один Counterparty может иметь несколько ролей одновременно (например,
// сотрудник, который заодно покупает у компании) — но MVP считает role
// атомарной. Можно расширить полем `roles String[]` позже без миграции данных.

model Counterparty {
  id          String           @id @default(cuid())
  workspaceId String
  role        CounterpartyRole @default(OTHER)
  name        String
  contact     String?
  note        String?
  isArchived  Boolean          @default(false)

  // Поля, релевантные только для определённых ролей.
  inn      String? // SUPPLIER / юр.лицо: 10 или 12 цифр
  source   String? // CLIENT: «Avito», «сарафан», «Telegram»
  position String? // EMPLOYEE: должность
  payRate  Decimal? @db.Decimal(14, 2) // EMPLOYEE: ставка/оклад (для seed расчётов)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  ordersAsClient    Order[]            @relation("OrderClient")
  warehouseDefaults WarehouseItem[]    @relation("WarehouseDefaultSupplier")
  purchases         Purchase[]         @relation("PurchaseSupplier")
  stockLotsSupplied StockLot[]         @relation("StockLotSupplier")
  recurringPayments RecurringPayment[] @relation("RecurringCounterparty")
  plannedPayments   PlannedPayment[]   @relation("PlannedCounterparty")

  @@index([workspaceId, role, isArchived])
  @@index([workspaceId, deletedAt])
}

enum CounterpartyRole {
  CLIENT
  SUPPLIER
  EMPLOYEE
  OTHER
}

// ───────────────────────────── Orders ─────────────────────────────
//
// Заказ — единица продажи (сборка / услуга / товар / смешанный).
// Финализация (DONE) атомарно: списывает позиции со склада по unitCostAtSale,
// фиксирует COGS, проверяет полноту оплаты.
//
// Платежи — отдельные Transaction(kind=ORDER_PAYMENT, orderId=...).
// Возвраты — Transaction(kind=ORDER_REFUND, orderId=..., originalTxId=ссылка).

model Order {
  id          String  @id @default(cuid())
  workspaceId String
  clientId    String? // null для разовых продаж без клиента
  /// Уникальный читаемый номер: «ORD-2026-0042»
  number      String
  title       String?
  description String?

  status        OrderStatus       @default(OPEN)
  paymentStatus OrderPaymentState @default(UNPAID)

  /// Итог = sum(items) - discountAmount; кэшируется триггером сервиса.
  subtotal       Decimal @default(0) @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal @default(0) @db.Decimal(14, 2)
  /// sum(ORDER_PAYMENT) - sum(ORDER_REFUND), кэшируется триггером.
  paidAmount     Decimal @default(0) @db.Decimal(14, 2)

  expectedDate DateTime? // планируемая дата выполнения
  closedAt     DateTime? // дата перехода в DONE

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workspace      Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client         Counterparty?          @relation("OrderClient", fields: [clientId], references: [id])
  items          OrderItem[]
  transactions   Transaction[]          @relation("OrderTransactions")
  attachments    Attachment[]
  schedule       PaymentScheduleEntry[]
  returns        OrderReturn[]          @relation("OrderReturns")
  wbReceiptLines WbReceiptLine[]        @relation("WbReceiptLineOrder")

  // Уникальность номера — partial-unique (WHERE deletedAt IS NULL), заведена
  // сырым SQL в миграции *_phase4_sku_number_unique: Prisma не умеет
  // partial-@@unique, а глобальный блокировал бы повторное использование номера
  // после soft-delete. Индекс не отражён в схеме → drift (см. CLAUDE.md грабли).
  @@index([workspaceId, status, expectedDate])
  @@index([workspaceId, clientId])
  @@index([workspaceId, deletedAt])
}

enum OrderStatus {
  OPEN // принят в работу, можно принимать оплату; склад ещё не тронут
  DONE // выполнен: склад списан по WAVG, COGS зафиксирован
  CANCELLED // отменён до DONE; деньги по нему возвращены (если были оплаты)
}

enum OrderPaymentState {
  UNPAID
  PARTIAL
  PAID
  OVERPAID
  REFUNDED
}

// F2 (#8/8a): формальный график платежей заказа — план «суммы + даты».
// План, не учёт: платежи НЕ привязываются к строкам — покрытие строк выводится
// FIFO по (dueDate, seq) из Order.paidAmount (см. orders/payment-schedule.ts).
// Σ строк МОЖЕТ расходиться с totalAmount — мягкое предупреждение в UI, не ошибка.
model PaymentScheduleEntry {
  id          String   @id @default(cuid())
  workspaceId String
  orderId     String
  /// Порядок строки — вторичный ключ FIFO-погашения (после dueDate).
  seq         Int
  /// Срок платежа; просрочка наступает после КОНЦА этого дня в поясе бизнеса (UTC+5).
  dueDate     DateTime
  amount      Decimal  @db.Decimal(14, 2)
  note        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// seq уникален в заказе: инвариант FIFO-порядка, защита от бага-дубля.
  @@unique([orderId, seq])
  @@index([workspaceId, orderId])
  @@index([workspaceId, dueDate])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  warehouseItemId String? // null = услуга / разовая позиция без склада
  name            String // снапшот имени (даже если warehouseItem удалят)
  /// Кол-во в штуках / кг / часах. Decimal(14,3) — поддержка дробных.
  qty             Decimal  @db.Decimal(14, 3)
  unitPrice       Decimal  @db.Decimal(14, 2)
  /// Закупочная себестоимость единицы, введённая вручную (для маржи).
  /// Имеет приоритет над WAVG-снапшотом при расчёте заработка.
  unitCost        Decimal? @db.Decimal(14, 4)
  /// Себестоимость единицы на момент перехода Order в DONE (снапшот WAVG).
  /// null пока заказ не финализирован.
  unitCostAtSale  Decimal? @db.Decimal(14, 4)
  /// Возвращённое количество (для частичных возвратов).
  returnedQty     Decimal  @default(0) @db.Decimal(14, 3)
  /// Отгруженное количество (частичная отгрузка). Склад списывается по мере
  /// отгрузки; finalize отгружает остаток (qty − shippedQty).
  shippedQty      Decimal  @default(0) @db.Decimal(14, 3)

  /// Кэш итога: qty * unitPrice.
  lineTotal Decimal @db.Decimal(14, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouseItem WarehouseItem? @relation(fields: [warehouseItemId], references: [id])
  returns       OrderReturn[]
  // Ф6: строка чека WB, породившая эту позицию (маркировка «в заказ»).
  wbReceiptLine WbReceiptLine? @relation("WbReceiptLineOrderItem")

  @@index([orderId])
  @@index([warehouseItemId])
}

/// Событие возврата клиента (RMA) по позиции заказа — IJ9 «месяц возврата»:
/// ОПиУ/марже нужна ДАТА возврата, а OrderItem.returnedQty — накопительный кэш
/// без даты (инвариант: Σ qty событий позиции == её returnedQty). Пишется
/// атомарно в order.service.returnItem(); история засеяна backfill-миграцией
/// (note LIKE 'BACKFILL%', даты best-effort).
model OrderReturn {
  id            String   @id @default(cuid())
  workspaceId   String
  orderId       String
  orderItemId   String
  /// Возвращённое количество ЭТИМ событием (не накопительно).
  qty           Decimal  @db.Decimal(14, 3)
  /// Минус выручки этого события (qty × unitPrice позиции, money-округление).
  revenueAmount Decimal  @db.Decimal(14, 2)
  /// Минус COGS этого события. Считается дельтой признанной себестоимости:
  /// (netQty×unitCostAtSale ДО) − (netQty×unitCostAtSale ПОСЛЕ пересчёта) —
  /// точно согласуется с FIFO-инвариантом маржи (I8) и без ошибок округления
  /// поединичной цены.
  costAmount    Decimal  @db.Decimal(14, 2)
  /// Сколько денег вернули этим событием (инфо; 0 — возврат без денег).
  refundAmount  Decimal  @db.Decimal(14, 2)
  /// Дата возврата (бизнес-семантика периода отчётов).
  date          DateTime
  /// BACKFILL-события миграции и произвольные пометки.
  note          String?
  createdAt     DateTime @default(now())
  createdById   String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order     Order     @relation("OrderReturns", fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  createdBy User      @relation("OrderReturnCreatedBy", fields: [createdById], references: [id])

  @@index([workspaceId, date])
  @@index([orderId])
  @@index([orderItemId])
}

// ───────────────────────────── Warehouse ─────────────────────────────
//
// Простая модель склада: одна строка на SKU, в ней текущее количество
// и средневзвешенная цена (WAVG). Ни журнала движений, ни резервов —
// история восстанавливается из PurchaseLine (приход) + OrderItem.returnedQty
// (возвраты) + AuditLog (ручные корректировки).
//
// Резервирование под OPEN-заказы НЕ ведётся: списание со склада происходит
// только при переходе заказа в DONE. Если на DONE не хватает qty — сервис
// возвращает ошибку.
//
// avgCost пересчитывается **только** в двух местах:
//   1. PURCHASE: newAvg = (oldQty*oldAvg + lineQty*linePrice) / (oldQty + lineQty)
//   2. SUPPLIER_RETURN: newAvg = (oldTotalCost - refundAmount) / (oldQty - returnQty)
// При продаже (списании при DONE) и возврате от клиента avgCost НЕ меняется.

model WarehouseItem {
  id                String   @id @default(cuid())
  workspaceId       String
  /// SKU / артикул, человекочитаемый. Опционально.
  sku               String?
  name              String
  /// Цвет комплектующего — свободный текст (решение #1). На учёт не влияет.
  color             String?
  /// Единица измерения: «шт», «кг», «ч», «м».
  unit              String   @default("шт")
  /// DERIVED-КЭШ остатка. Истина — StockLot: qty == Σ open lot.qtyRemaining.
  /// Пересчитывается recomputeCaches() в той же UoW под FOR UPDATE.
  qty               Decimal  @default(0) @db.Decimal(14, 3)
  /// DERIVED-КЭШ средневзвешенной себестоимости (подсказка для lowStock/UI).
  /// Истина — StockLot: avgCost == Σ(qtyRemaining*unitCost)/Σ qtyRemaining (0 если пусто).
  avgCost           Decimal  @default(0) @db.Decimal(14, 4)
  /// Точка дозаказа: при qty <= reorderPoint позиция попадает в low-stock.
  /// null — порог не задан, в low-stock не сигналит.
  reorderPoint      Decimal? @db.Decimal(14, 3)
  /// Поставщик по умолчанию (для подсказок при закупке).
  defaultSupplierId String?
  note              String?
  isArchived        Boolean  @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  defaultSupplier Counterparty?   @relation("WarehouseDefaultSupplier", fields: [defaultSupplierId], references: [id])
  orderItems      OrderItem[]
  purchaseLines   PurchaseLine[]
  stockMovements  StockMovement[]
  lots            StockLot[]
  wbReceiptLines  WbReceiptLine[] @relation("WbReceiptLineItem")

  // Уникальность sku — partial-unique (WHERE deletedAt IS NULL AND sku IS NOT
  // NULL), заведена сырым SQL в миграции *_phase4_sku_number_unique (см. Order
  // и CLAUDE.md грабли). sku опционален, поэтому NULL'ы из индекса исключены.
  @@index([workspaceId, isArchived])
  @@index([workspaceId, deletedAt])
}

// ───────────────────────────── Stock movements ─────────────────────────────
//
// Неизменяемый журнал движений склада (append-only). Каждое изменение qty
// любого WarehouseItem пишет одну строку внутри той же UoW-транзакции, что и
// само изменение (applyPurchaseLine / decrementForSale / restock / adjust /
// opening). qtyAfter — снимок остатка ПОСЛЕ применения, для аудита и
// восстановления истории без пересчёта.
//
// refType/refId — слабая ссылка на источник (Purchase, Order, Transfer и т.п.);
// без FK, т.к. источники разнородны и могут быть soft-deleted.
// Движения НЕ создают Transaction сами по себе (cash-basis): деньги пишет
// вызывающий use-case отдельно.

model StockMovement {
  id              String            @id @default(cuid())
  workspaceId     String
  warehouseItemId String
  type            StockMovementType
  /// Изменение остатка: + приход, − расход. В единицах измерения SKU.
  qtyDelta        Decimal           @db.Decimal(14, 3)
  /// Остаток ПОСЛЕ применения движения (снимок).
  qtyAfter        Decimal           @db.Decimal(14, 3)
  /// Себестоимость единицы в этом движении (приход — цена прихода; расход —
  /// unitCostAtSale). null для чисто количественных корректировок.
  unitCost        Decimal?          @db.Decimal(14, 4)
  /// Источник движения: «PURCHASE» | «ORDER» | «TRANSFER» | «ADJUST» и т.п.
  refType         String?
  refId           String?
  /// Человекочитаемая причина (для ADJUSTMENT / WRITE_OFF / RETURN_*).
  reason          String?
  createdAt       DateTime          @default(now())
  createdById     String

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  warehouseItem   WarehouseItem    @relation(fields: [warehouseItemId], references: [id])
  createdBy       User             @relation("StockMovementCreatedBy", fields: [createdById], references: [id])
  lotConsumptions LotConsumption[]

  @@index([workspaceId, warehouseItemId, createdAt])
  @@index([workspaceId, type, createdAt])
  @@index([refType, refId])
}

enum StockMovementType {
  PURCHASE // приход с закупки
  SALE // расход при продаже (финализация заказа)
  RETURN_CUSTOMER // возврат от клиента → приход
  RETURN_SUPPLIER // возврат поставщику → расход
  ADJUSTMENT // ручная корректировка остатка (±)
  WRITE_OFF // списание (брак, недостача)
  OPENING // начальный остаток при импорте склада
}

// ───────────────────────────── Purchases ─────────────────────────────
//
// Закупка на склад. Одна Purchase = одна Transaction(kind=PURCHASE) (1:1):
// транзакция отражает движение денег (списание со счёта), Purchase —
// что именно куплено (строки PurchaseLine). В одной закупке может быть
// несколько SKU.
//
// Создаётся атомарно use-case'ом RegisterPurchase:
//   1. Transaction(kind=PURCHASE, amount=sum(lines.lineTotal))
//   2. Purchase + PurchaseLine[]
//   3. на каждую строку: WarehouseItem.qty += qty, пересчёт avgCost (WAVG)

model Purchase {
  id            String  @id @default(cuid())
  workspaceId   String
  transactionId String  @unique // 1:1 — деньги этой закупки
  supplierId    String?
  note          String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transaction Transaction    @relation("PurchaseTransaction", fields: [transactionId], references: [id], onDelete: Cascade)
  supplier    Counterparty?  @relation("PurchaseSupplier", fields: [supplierId], references: [id])
  lines       PurchaseLine[]

  @@index([workspaceId, createdAt])
  @@index([supplierId])
  @@index([workspaceId, deletedAt])
}

model PurchaseLine {
  id              String  @id @default(cuid())
  purchaseId      String
  warehouseItemId String
  /// Кол-во в единицах измерения SKU.
  qty             Decimal @db.Decimal(14, 3)
  /// Цена закупки за единицу (без НДС — суммы итоговые).
  unitPrice       Decimal @db.Decimal(14, 4)
  /// Кэш: qty * unitPrice.
  lineTotal       Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  purchase      Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  warehouseItem WarehouseItem @relation(fields: [warehouseItemId], references: [id])
  lots          StockLot[]

  @@index([purchaseId])
  @@index([warehouseItemId])
}

// ───────────────────────────── Stock lots (FIFO) ─────────────────────────────
//
// Партионный (FIFO) учёт себестоимости. Истина по складу — НЕ WarehouseItem.qty/avgCost
// (это derived-кэши), а набор StockLot: каждая закупка/приход создаёт партию со своей
// unitCost, поставщиком, счётом и датой поступления. Любой расход (продажа, возврат
// поставщику, инвентаризация-вниз, write-off) списывает партии в FIFO-порядке
// (receivedAt ASC, seq ASC) и пишет append-only-запись LotConsumption. Возврат клиента и
// откат финализации РЕВЕРСИРУЮТ конкретные потребления (восстанавливают qtyRemaining тех
// же партий по их СНИМОЧНОЙ себестоимости).
//
// Сериализация — на строке WarehouseItem (repo.lockForUpdate FOR UPDATE): пока UoW держит
// строку SKU, лоты этого SKU мутируются эксклюзивно. Мутации лотов всегда внутри этого лока.

model StockLot {
  id              String         @id @default(cuid())
  workspaceId     String
  warehouseItemId String
  /// Полученное количество партии (неизменно после создания).
  qtyInitial      Decimal        @db.Decimal(14, 3)
  /// Остаток партии = qtyInitial − Σ(LotConsumption.qty со знаком). КЭШ; цель FOR UPDATE при списании.
  qtyRemaining    Decimal        @db.Decimal(14, 3)
  /// Себестоимость единицы партии, >= 0 (CHECK в миграции).
  unitCost        Decimal        @db.Decimal(14, 4)
  sourceType      StockLotSource
  /// Слабая ссылка на источник (Purchase.id / Order.id / Adjust). Без FK — источники разнородны.
  sourceId        String?
  /// Сильная трасса к строке закупки (F5). null для OPENING/MIGRATION/ADJUSTMENT/возврата.
  purchaseLineId  String?
  /// Трасса до поставщика (F5). null для OPENING/MIGRATION.
  supplierId      String?
  /// Трасса до счёта оплаты закупки (F5). null где неприменимо.
  accountId       String?
  /// Бизнес-дата поступления — ПЕРВИЧНЫЙ ключ FIFO-сортировки.
  receivedAt      DateTime
  /// Монотонный детерминированный tie-break FIFO при равных receivedAt.
  seq             BigInt         @default(autoincrement())
  createdAt       DateTime       @default(now())
  createdById     String
  /// soft-delete для единообразия; в норме лоты не удаляем (исчерпание = qtyRemaining→0).
  deletedAt       DateTime?

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  warehouseItem WarehouseItem    @relation(fields: [warehouseItemId], references: [id])
  purchaseLine  PurchaseLine?    @relation(fields: [purchaseLineId], references: [id], onDelete: SetNull)
  supplier      Counterparty?    @relation("StockLotSupplier", fields: [supplierId], references: [id])
  account       Account?         @relation("StockLotAccount", fields: [accountId], references: [id])
  createdBy     User             @relation("StockLotCreatedBy", fields: [createdById], references: [id])
  consumptions  LotConsumption[]

  // FIFO-скан/лок по бизнес-порядку (receivedAt, seq). Partial-вариант
  // (WHERE qtyRemaining>0 AND deletedAt IS NULL) заводится сырым SQL в миграции (known-drift).
  @@index([workspaceId, warehouseItemId, receivedAt, seq])
  @@index([purchaseLineId])
  @@index([workspaceId, supplierId])
}

enum StockLotSource {
  PURCHASE // партия из закупки (есть purchaseLineId/supplierId/accountId)
  OPENING // начальный остаток (create openingQty / import)
  MIGRATION // единый лот при WAVG→FIFO миграции (supplier/account=null)
  ADJUSTMENT // излишек инвентаризации (adjust delta>0)
  RETURN_CUSTOMER // FALLBACK-лот возврата клиента (нет исходных потреблений)
}

// Append-only леджер потреблений/реверсов партий. Каждая лот-операция (списание или
// восстановление) пишет запись со СНИМКОМ unitCost партии на момент операции. Реверс
// возврата клиента берёт цену из снимка реверсируемой CONSUME-строки, НЕ из текущего
// lot.unitCost → возврат cost-neutral (снимает конфликт с setCost).

model LotConsumption {
  id           String             @id @default(cuid())
  workspaceId  String
  lotId        String
  /// Движение-источник (SALE/RETURN_SUPPLIER/WRITE_OFF/ADJUSTMENT для CONSUME;
  /// RETURN_CUSTOMER для REVERSAL). Всегда задано.
  movementId   String
  /// Денорм. слабая ссылка на строку заказа — ключ адресного реверса и пер-строчной трассы.
  orderItemId  String?
  /// Знаковое: + списание (CONSUME), − восстановление (REVERSAL). CHECK qty <> 0 в миграции.
  qty          Decimal            @db.Decimal(14, 3)
  /// Снимок lot.unitCost на момент операции. Реверс берёт цену отсюда.
  unitCost     Decimal            @db.Decimal(14, 4)
  kind         LotConsumptionKind @default(CONSUME)
  /// Для REVERSAL — ссылка на реверсируемую CONSUME-строку (учёт остаточной реверсируемости).
  reversalOfId String?
  createdAt    DateTime           @default(now())

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lot        StockLot         @relation(fields: [lotId], references: [id])
  movement   StockMovement    @relation(fields: [movementId], references: [id])
  reversalOf LotConsumption?  @relation("ConsumptionReversal", fields: [reversalOfId], references: [id])
  reversals  LotConsumption[] @relation("ConsumptionReversal")

  @@index([lotId])
  @@index([orderItemId])
  @@index([movementId])
  @@index([reversalOfId])
}

enum LotConsumptionKind {
  CONSUME // списание (+qty)
  REVERSAL // восстановление при возврате/откате (−qty)
}

// ───────────────────────────── Transactions ─────────────────────────────
//
// Единая таблица всех движений денег. type (INCOME/EXPENSE) — для быстрых
// агрегатов; kind — для бухгалтерской классификации.
// Правила соответствия (валидируются на сервисе, не в БД):
//   INCOME:  ORDER_PAYMENT, CAPITAL_IN, SUPPLIER_REFUND, OTHER (если category.kind=INCOME)
//   EXPENSE: PURCHASE, SALARY, TAX, FIXED_COST, VARIABLE_COST, NON_OP, CAPITAL_OUT, ORDER_REFUND, OTHER
//
// Сторно: originalTxId ссылается на оригинальную операцию.
// Сумма сторно = -original.amount, type/kind тот же.

model Transaction {
  id          String          @id @default(cuid())
  workspaceId String
  date        DateTime
  amount      Decimal         @db.Decimal(14, 2)
  type        TxType
  kind        TransactionKind @default(OTHER)

  accountId      String
  categoryId     String?
  counterpartyId String?
  description    String?

  // Доменные привязки (опциональные).
  orderId         String? // ORDER_PAYMENT, ORDER_REFUND
  // Перевод между своими счетами: обе ноги (TRANSFER_IN/TRANSFER_OUT) делят общий
  // transferGroupId = Transfer.id. Исключаются из P&L и из консолид. cashflow.
  transferGroupId String?
  // PURCHASE-детали (что куплено, в какой склад) живут в Purchase/PurchaseLine,
  // связанных 1:1 через Transaction.purchase.

  // Сторно / правки в закрытом периоде.
  originalTxId   String?
  reversalReason String?

  // Ф4 (Налог АУСН Д−Р). ausnMark — АУСН-классификация операции:
  // приоритетна маркировка банка из API (перенос со строки выписки при разборе
  // Inbox) ИЛИ ручное переопределение оператора; null → авто по kind/type
  // (см. reports/ausn-classify). taxPeriod (YYYY-MM) — период, за который уплачен
  // налог (заполняется у TAX-расхода из вкладки «Налог»; сверка начислено/уплачено).
  ausnMark  AusnMark?
  taxPeriod String?

  // Метаданные.
  importBatchId String?
  importHash    String?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account        Account            @relation(fields: [accountId], references: [id])
  category       Category?          @relation(fields: [categoryId], references: [id])
  counterparty   Counterparty?      @relation(fields: [counterpartyId], references: [id])
  order          Order?             @relation("OrderTransactions", fields: [orderId], references: [id])
  transfer       Transfer?          @relation("TransferLegs", fields: [transferGroupId], references: [id])
  purchase       Purchase?          @relation("PurchaseTransaction")
  originalTx     Transaction?       @relation("Reversals", fields: [originalTxId], references: [id])
  reversals      Transaction[]      @relation("Reversals")
  importBatch    ImportBatch?       @relation(fields: [importBatchId], references: [id])
  createdBy      User               @relation("TransactionCreatedBy", fields: [createdById], references: [id])
  attachments    Attachment[]
  // Ф1: строка банковской выписки, из которой создана эта проводка (авто-разбор
  // Inbox). SetNull держится через сервис (правка/удаление проводки возвращает
  // строку в Inbox); FK — целостность на случай hard-delete.
  bankLine       BankStatementLine? @relation("BankLineTransaction")
  // Ф6: чек WB, чьи деньги эта проводка (создана разбором или привязана).
  wbReceipt      WbReceipt?         @relation("WbReceiptTransaction")
  // Ф5: плановый платёж, который закрыла эта проводка (оплата плана/зарплаты).
  plannedPayment PlannedPayment?    @relation("PlannedPaymentTransaction")

  @@index([workspaceId, date])
  @@index([workspaceId, kind, date])
  @@index([workspaceId, accountId, date])
  @@index([workspaceId, categoryId, date])
  @@index([workspaceId, counterpartyId, date])
  @@index([workspaceId, type, date])
  @@index([workspaceId, orderId])
  @@index([workspaceId, transferGroupId])
  @@index([workspaceId, deletedAt])
  @@index([workspaceId, importHash])
  // Ф4: выборка TAX-платежей по периоду (сверка «уплачено»).
  @@index([workspaceId, taxPeriod])
  @@index([importBatchId])
  @@index([originalTxId])
}

enum TxType {
  INCOME
  EXPENSE
}

enum TransactionKind {
  // INCOME
  ORDER_PAYMENT // оплата по заказу от клиента
  CAPITAL_IN // вложение собственника
  SUPPLIER_REFUND // возврат денег от поставщика — контр-закупка (бакет PURCHASES, не выручка)

  // EXPENSE
  ORDER_REFUND // возврат клиенту (минус выручка)
  COGS // себестоимость проданного по заказу (авто при закрытии заказа)
  WRITE_OFF // списание со склада (брак/порча/недостача) — НЕДЕНЕЖНЫЙ убыток в P&L (F4, решение #10)
  PURCHASE // закупка на склад — атомарно списывает деньги + увеличивает qty
  SALARY // зарплата сотруднику
  TAX // налоги, страховые
  FIXED_COST // постоянные издержки
  VARIABLE_COST // переменные коммерческие
  NON_OP // внереализационные
  CAPITAL_OUT // изъятие собственника

  // Переводы между своими счетами (нога перевода, общий transferGroupId).
  // НЕ участвуют в P&L; в консолидированном cashflow гасят друг друга.
  TRANSFER_IN // приход на счёт-получатель
  TRANSFER_OUT // списание со счёта-источника (включая fee, если есть)

  // Универсальный — для случаев, не покрытых явными kind'ами.
  OTHER
}

// ───────────────────────────── Transfers ─────────────────────────────
//
// Перевод денег между двумя своими счетами (любых классов). Создаётся атомарно:
// одна Transfer + две связанные Transaction-ноги (TRANSFER_OUT со счёта-источника
// на amount+fee, TRANSFER_IN на счёт-получатель на amount), общий
// transferGroupId = Transfer.id. fee (комиссия эквайринга/МП/банка) при наличии
// постится отдельной Transaction(VARIABLE_COST) — это реальный расход, в отличие
// от самого перевода. Ноги исключаются из P&L и гасятся в консолид. cashflow.

model Transfer {
  id            String   @id @default(cuid())
  workspaceId   String
  fromAccountId String
  toAccountId   String
  /// Переводимая сумма (поступает на счёт-получатель).
  amount        Decimal  @db.Decimal(14, 2)
  /// Комиссия за перевод (удерживается сверх amount со счёта-источника).
  fee           Decimal  @default(0) @db.Decimal(14, 2)
  date          DateTime
  note          String?
  createdById   String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromAccount Account             @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccount   Account             @relation("TransferTo", fields: [toAccountId], references: [id])
  createdBy   User                @relation("TransferCreatedBy", fields: [createdById], references: [id])
  legs        Transaction[]       @relation("TransferLegs")
  bankLines   BankStatementLine[] @relation("BankLineTransfer")

  @@index([workspaceId, date])
  @@index([workspaceId, deletedAt])
  @@index([fromAccountId])
  @@index([toAccountId])
}

// ───────────────────────────── Account balance checks ─────────────────────────────
//
// Сверка: пользователь вводит фактический остаток счёта на дату (выписка,
// пересчёт кассы). Отчёт сверки сравнивает расчётный остаток (openingBalance +
// Σ транзакций) с actualBalance и показывает расхождение. Append-only снимки.

model AccountBalanceCheck {
  id            String   @id @default(cuid())
  workspaceId   String
  accountId     String
  date          DateTime
  /// Фактический остаток на дату (что реально на счёте/в кассе).
  actualBalance Decimal  @db.Decimal(14, 2)
  note          String?
  createdById   String

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id])
  createdBy User      @relation("BalanceCheckCreatedBy", fields: [createdById], references: [id])

  @@index([workspaceId, accountId, date])
}

// ───────────────────────────── Import batches ─────────────────────────────

model ImportBatch {
  id           String       @id @default(cuid())
  workspaceId  String
  userId       String
  source       ImportSource
  filename     String
  fileHash     String
  rowsTotal    Int
  rowsImported Int
  rowsSkipped  Int          @default(0)
  createdAt    DateTime     @default(now())
  deletedAt    DateTime?

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, deletedAt])
}

enum ImportSource {
  GENERIC_CSV
  GENERIC_XLSX
  ALFA_XLSX
  TINKOFF_PDF
  WB_PDF
}

// ───────────────────────────── Category rules (auto-mapping) ─────────────────

/// Движок правил (конфигурируемость Блок 1): обобщение CategoryRule до
/// «условие → действие». conditions/actions — JSON из фиксированного zod-словаря
/// (см. rule.dto.ts); id категорий/контрагентов/счетов внутри JSON проверяются на
/// принадлежность workspace в сервисе (FK внутри JSON не enforce-ится, это норма
/// для rule-движка). При ручном вводе и в превью импорта — подсказка, которую
/// подтверждает человек; строку банковской выписки правило проводит СРАЗУ
/// (BankStatementLine.status=AUTO_POSTED + appliedRuleId), откат — через Inbox.
model Rule {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  priority    Int       @default(0)
  isActive    Boolean   @default(true)
  appliesTo   String    @default("BOTH") /// IMPORT | MANUAL | BOTH
  conditions  Json /// RuleCondition[]
  actions     Json /// RuleAction[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isActive, priority])
  @@index([workspaceId, deletedAt])
}

// ───────────────────────────── Attachments ─────────────────────────────

// Вложение может принадлежать транзакции ИЛИ заказу (полиморфно через
// nullable FK). workspaceId хранится напрямую — для простого scoping и
// дедупликации файлов в пределах пространства.
model Attachment {
  id            String   @id @default(cuid())
  workspaceId   String
  transactionId String?
  orderId       String?
  filename      String
  mimeType      String
  size          Int
  storagePath   String
  hash          String
  createdAt     DateTime @default(now())

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([transactionId])
  @@index([orderId])
  @@index([hash])
}

// ───────────────────────────── Audit & Idempotency ─────────────────────────
//
// AuditLog пишется декоратором на репозиториях для критичных доменных
// действий (Order.cancel/finalize, Transaction.delete
// в закрытом периоде, WarehouseItem.adjustment).
//
// IdempotencyKey используется middleware'ом для всех mutating-эндпойнтов:
// клиент шлёт заголовок Idempotency-Key, сервер хранит ответ TTL=24ч.

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  actorId     String?
  action      String
  entityType  String
  entityId    String
  diff        Json
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor     User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

model IdempotencyKey {
  key          String    @id
  requestHash  String
  responseBody Json
  /// null = ключ «застолблён», запрос ещё выполняется; ставится при завершении.
  /// Различает in-flight от готового ответа для атомарной идемпотентности.
  completedAt  DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@index([expiresAt])
}

// ───────────────────────────── Интеграции (Ф1 «Полный автомат») ─────────────
//
// Подключение внешнего источника операций (банк по API / карта через PDF).
// Секрет (токен банка) шифруется AES-256-GCM мастер-ключом из env и хранится
// строкой `v1.<nonce>.<tag>.<ciphertext>` (base64) — наружу отдаётся только
// маска keyLast4. Управление — ТОЛЬКО владелец workspace (OwnerGuard).

model IntegrationConnection {
  id            String              @id @default(cuid())
  workspaceId   String
  provider      IntegrationProvider
  /// Счёт, на который ложатся операции этого подключения.
  accountId     String
  /// Зашифрованный токен (AES-256-GCM, формат `v1.<nonce>.<tag>.<ct>`).
  credentialEnc String
  /// Маска ключа для UI (последние 4 символа) — сам ключ наружу не отдаётся.
  keyLast4      String
  /// Идентификатор счёта на стороне провайдера: у Альфы — номер расчётного
  /// счёта, он обязателен в запросе выписки (Ф2). Не секрет (реквизит есть в
  /// каждом платёжном поручении), поэтому хранится открыто и виден в UI.
  externalAccountId String?
  /// Клиентский сертификат mTLS для Альфы: JSON {cert, key, passphrase},
  /// зашифрованный тем же мастер-ключом, что и credentialEnc.
  ///
  /// Живёт в подключении, а не в env сервера, потому что банк выдаёт сертификат
  /// на конкретную компанию по договору: у двух пространств (разные ИП) —
  /// разные сертификаты. Null → используется сертификат из env (обратная
  /// совместимость) либо, если и его нет, синк честно скажет, что не настроен.
  tlsCredentialEnc  String?
  /// Отпечаток SHA-256 загруженного сертификата — показать в UI, какой именно
  /// сертификат стоит. Не секрет (публичная часть).
  tlsFingerprint    String?
  /// Срок действия сертификата: чтобы предупредить об истечении заранее, а не
  /// ловить внезапный отказ TLS-рукопожатия.
  tlsExpiresAt      DateTime?
  status        IntegrationStatus   @default(ACTIVE)
  /// С какой даты тянуть выписку. Null — с даты подключения (поведение по
  /// умолчанию: историю до подключения обычно заносили руками).
  ///
  /// Нужно для перезалива истории: банк хранит операции годами (Альфа — 5 лет,
  /// Т-Банк — с июня 2023), а адаптеры без этого поля стартовали строго с
  /// момента создания подключения, и прошлое было недостижимо. Сдвиг даты назад
  /// сбрасывает syncCursor — иначе синк продолжил бы с уже пройденного места.
  backfillFrom  DateTime?
  /// Курсор инкрементальной синхронизации (provider-специфичный, напр. дата/id).
  syncCursor    String?
  lastSyncAt    DateTime?
  lastSyncError String?
  createdById   String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account   Account             @relation(fields: [accountId], references: [id])
  createdBy User                @relation("IntegrationCreatedBy", fields: [createdById], references: [id])
  lines     BankStatementLine[]

  @@index([workspaceId, deletedAt])
  @@index([accountId])
}

// Строка выписки из подключения — staging для экрана «Входящие» (Inbox).
// Идемпотентность синка: @@unique([connectionId, externalId]) (id операции
// у банка). Первая линия дедупа против ручного ввода — importHash-совместимость
// решается на уровне сервиса синка (Ф1-B).
model BankStatementLine {
  id                  String         @id @default(cuid())
  workspaceId         String
  connectionId        String
  /// Идентификатор операции у провайдера (для идемпотентного upsert).
  externalId          String
  date                DateTime
  amount              Decimal        @db.Decimal(14, 2)
  /// Знак операции: INCOME — приход, EXPENSE — расход.
  direction           TxType
  counterpartyName    String?
  counterpartyInn     String?
  /// Назначение платежа.
  description         String?
  /// Маркировка АУСН от банка (для сверки Ф4): доход/расход/не учитывается.
  ausnMark            AusnMark?
  status              BankLineStatus @default(NEW)
  /// Подсказка Rule-движка (для UI и авто-проводки).
  suggestedCategoryId String?
  /// Правило, автоматически проведшее строку (status=AUTO_POSTED). Без FK — как и
  /// suggestedCategoryId: правило живёт с soft-delete, а ссылка нужна историческая,
  /// чтобы ревизовать и массово откатить результат конкретного правила.
  appliedRuleId       String?
  /// Проводка, созданная из строки (авто или вручную из Inbox). 1:1 — одна
  /// строка порождает не более одной проводки.
  transactionId       String?        @unique
  /// Перевод, к которому отнесена строка (обе ноги детекта переводов, 1:many).
  transferId          String?
  /// Сырой ответ провайдера — для форензики/повторного разбора.
  raw                 Json?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection  IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transaction Transaction?          @relation("BankLineTransaction", fields: [transactionId], references: [id], onDelete: SetNull)
  transfer    Transfer?             @relation("BankLineTransfer", fields: [transferId], references: [id], onDelete: SetNull)

  @@unique([connectionId, externalId])
  @@index([workspaceId, status, date])
  @@index([connectionId, status])
  // Массовый откат «всё, что провело правило X» и счётчик срабатываний.
  @@index([workspaceId, appliedRuleId])
  // transactionId не индексируем отдельно — @unique уже создаёт уникальный индекс.
  @@index([transferId])
}

enum IntegrationProvider {
  ALFA // Альфа-Бизнес API (р/с ИП)
  TBANK // Т-Бизнес OpenAPI (р/с ИП)
  WB_CARD // карта ВБ-банка (физлицо) — через PDF-парсинг
}

enum IntegrationStatus {
  ACTIVE // синхронизируется
  ERROR // последний синк упал (см. lastSyncError)
  DISABLED // выключено владельцем, синк не идёт
}

enum BankLineStatus {
  NEW // ждёт разбора в Inbox
  AUTO_POSTED // проведено автоматически по правилу (проводка создана)
  RESOLVED // разобрано вручную (проводка/заказ/закупка/перевод)
  DISMISSED // «не учитывать» — в отчёты не идёт
}

enum AusnMark {
  INCOME // банк отнёс к доходу для АУСН
  EXPENSE // банк отнёс к расходу для АУСН
  NOT_COUNTED // не учитывается в базе АУСН
}

// ─────────────────────── Чеки закупок (Ф6) ───────────────────────
// Документ разбора закупки: WB / ДНС / Онлайн Трейд (PDF) ИЛИ ручной ввод.
// Деньги = РОВНО ОДНА транзакция-расход (созданная разбором либо привязанная
// строка выписки карты — анти-задвоение), складские строки приходуются
// FIFO-партиями, заказные — становятся позициями заказов (себестоимость = цена
// строки). Идемпотентность повторной загрузки — по номеру документа (поле fpd:
// ФПД у WB / номер заказа-чека у ДНС/ОТ / null у ручного), partial-unique
// (workspaceId, fpd) WHERE deletedAt IS NULL; NULL-ключи не конфликтуют, поэтому
// ручных вводов может быть сколько угодно. Таблица исторически WbReceipt — имя
// оставлено (миграция-переименование на проде рискованнее, чем косметический долг).

model WbReceipt {
  id                 String          @id @default(cuid())
  workspaceId        String
  /// Источник документа (детерминирует парсер и наличие дедупа).
  source             WbReceiptSource @default(WB_CARD)
  /// Карта/счёт, с которого оплачена закупка (счёт workspace).
  accountId          String
  /// Деньги чека 1:1. null недолго: commit либо создаёт расход, либо привязывает
  /// существующую операцию; после отката созданная удаляется, привязанная отвязывается.
  transactionId      String?         @unique
  /// true — транзакцию создал разбор (откат её soft-удаляет);
  /// false — привязана существующая (откат только отвязывает).
  transactionCreated Boolean         @default(false)
  /// Ключ идемпотентности = номер документа: ФПД (WB) / номер заказа-чека
  /// (ДНС/ОТ) / null (ручной ввод — без дедупа). partial-unique по (ws, fpd).
  fpd                String?
  /// Номер фискального документа («No ФД») — форензика, WB/ДНС.
  fd                 String?
  checkNumber        String?
  receiptDate        DateTime
  totalAmount        Decimal         @db.Decimal(14, 2)
  note               String?
  createdById        String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account     Account         @relation("WbReceiptAccount", fields: [accountId], references: [id])
  transaction Transaction?    @relation("WbReceiptTransaction", fields: [transactionId], references: [id], onDelete: SetNull)
  createdBy   User            @relation("WbReceiptCreatedBy", fields: [createdById], references: [id])
  lines       WbReceiptLine[]

  @@index([workspaceId, receiptDate])
  @@index([workspaceId, deletedAt])
  @@index([accountId])
}

enum WbReceiptSource {
  WB_CARD // кассовый чек Wildberries (receipt.wb.ru)
  DNS // ДНС: кассовый чек или товарный заказ (6Б-…)
  ONLINE_TRADE // Онлайн Трейд: страница заказа ЛК
  MANUAL // ручной ввод без PDF
}

// Сгруппированная позиция чека (поштучные строки WB свёрнуты в кол-во) и её
// назначение после маркировки оператором.
model WbReceiptLine {
  id              String       @id @default(cuid())
  receiptId       String
  name            String
  qty             Decimal      @db.Decimal(14, 3)
  unitPrice       Decimal      @db.Decimal(14, 4)
  /// Кэш: qty × unitPrice (== сумме штук в чеке).
  lineTotal       Decimal      @db.Decimal(14, 2)
  /// Реальный продавец строки (WB — посредник-«поверенный»).
  sellerName      String?
  sellerInn       String?
  /// Хэш WB-заказа из кода маркировки — один чек несёт позиции разных заказов WB.
  wbOrderHash     String?
  target          WbLineTarget
  /// target=WAREHOUSE: товар, оприходованный этой строкой (FIFO-партия ссылается
  /// на строку слабой парой sourceType/sourceId).
  warehouseItemId String?
  /// target=ORDER: заказ и созданная в нём позиция (1:1 — ключ отката).
  orderId         String?
  orderItemId     String?      @unique
  createdAt       DateTime     @default(now())

  receipt       WbReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  warehouseItem WarehouseItem? @relation("WbReceiptLineItem", fields: [warehouseItemId], references: [id])
  order         Order?         @relation("WbReceiptLineOrder", fields: [orderId], references: [id])
  orderItem     OrderItem?     @relation("WbReceiptLineOrderItem", fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([receiptId])
  @@index([orderId])
  @@index([warehouseItemId])
}

enum WbLineTarget {
  WAREHOUSE // оприходована на склад (создана FIFO-партия)
  ORDER // добавлена позицией в заказ (себестоимость = цена чека)
  SKIPPED // пропущена оператором (личное/не учитывать)
}

// ─────────────────────────────────────────────────────────────────────────────
// Ф5. Регулярные и плановые платежи (надстройка над транзакционной шиной).
// Ядро (Transaction/деньги) неизменно: план лишь ПРЕДСКАЗЫВАЕТ будущий расход и
// при оплате кладёт обычную проводку на шину (matchedTransaction). Всё —
// суммы, график, привязки, статус — редактируется в приложении. Сотрудник —
// это Counterparty с role=EMPLOYEE (отдельной сущности не заводим).

enum RecurrenceCadence {
  MONTHLY // раз в месяц по числу dayOfMonth (клампится к длине месяца)
  WEEKLY // раз в неделю по дню недели weekday (0=вс..6=сб)
}

// Регулярный платёж-шаблон: аренда, подписки, интернет и т.п. Материализуется в
// PlannedPayment на горизонт вперёд (идемпотентно по recurringId+dueDate).
model RecurringPayment {
  id          String          @id @default(cuid())
  workspaceId String
  title       String
  amount      Decimal         @db.Decimal(14, 2)
  // Как ляжет на шину при оплате (обычно EXPENSE-kind: FIXED_COST/VARIABLE_COST/
  // SALARY/TAX). Тип (INCOME/EXPENSE) выводится из kind при создании проводки.
  txKind      TransactionKind @default(FIXED_COST)

  cadence    RecurrenceCadence @default(MONTHLY)
  dayOfMonth Int? // MONTHLY: 1..31
  weekday    Int? // WEEKLY: 0..6

  startDate DateTime // с какой даты правило активно
  endDate   DateTime? // необязательный конец
  leadDays  Int       @default(3) // за сколько дней напоминать
  isActive  Boolean   @default(true)

  // Привязки по умолчанию (переносятся в план и проводку); все опциональны.
  accountId      String?
  categoryId     String?
  counterpartyId String?
  note           String?

  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account      Account?         @relation("RecurringAccount", fields: [accountId], references: [id])
  category     Category?        @relation("RecurringCategory", fields: [categoryId], references: [id])
  counterparty Counterparty?    @relation("RecurringCounterparty", fields: [counterpartyId], references: [id])
  createdBy    User             @relation("RecurringCreatedBy", fields: [createdById], references: [id])
  planned      PlannedPayment[]

  @@index([workspaceId, isActive, deletedAt])
}

enum PlannedSource {
  RECURRING // сгенерирован из RecurringPayment
  SALARY // зарплата (ручной список выплат сотруднику)
  MANUAL // разовый плановый платёж
}

enum PlannedStatus {
  PLANNED // ожидается
  PAID // оплачен (есть проводка matchedTransaction)
  SKIPPED // в этот раз не платим (регулярку можно пропустить)
  CANCELLED // отменён
}

// Конкретный ожидаемый платёж с датой. Три источника: RECURRING (из шаблона),
// SALARY (ручная выплата сотруднику), MANUAL (разовый). При оплате создаётся
// обычная проводка на шине; matchedTransaction связывает план с фактом 1:1.
model PlannedPayment {
  id          String          @id @default(cuid())
  workspaceId String
  title       String
  amount      Decimal         @db.Decimal(14, 2)
  txKind      TransactionKind @default(FIXED_COST)
  dueDate     DateTime
  source      PlannedSource   @default(MANUAL)
  status      PlannedStatus   @default(PLANNED)
  leadDays    Int             @default(3)

  recurringId    String?
  accountId      String?
  categoryId     String?
  counterpartyId String? // для SALARY — сотрудник (Counterparty role=EMPLOYEE)
  note           String?

  // Проводка, закрывшая план (создана при «Оплатить» или привязана вручную).
  matchedTransactionId String? @unique
  // true — проводку создала сама оплата плана (при отмене её надо удалить);
  // false — привязана существующая операция (при отмене лишь отвязываем).
  autoTx               Boolean @default(false)

  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recurring          RecurringPayment? @relation(fields: [recurringId], references: [id])
  account            Account?          @relation("PlannedAccount", fields: [accountId], references: [id])
  category           Category?         @relation("PlannedCategory", fields: [categoryId], references: [id])
  counterparty       Counterparty?     @relation("PlannedCounterparty", fields: [counterpartyId], references: [id])
  matchedTransaction Transaction?      @relation("PlannedPaymentTransaction", fields: [matchedTransactionId], references: [id], onDelete: SetNull)
  createdBy          User              @relation("PlannedCreatedBy", fields: [createdById], references: [id])

  @@index([workspaceId, status, dueDate])
  @@index([recurringId])
}

/// Бюджет: месячный лимит расходов (или план доходов) по категории.
/// Один действующий лимит на категорию — действует каждый месяц, факт
/// считается за выбранный месяц (транзакции категории + её подкатегорий).
/// Уникальность (workspaceId, categoryId) при deletedAt IS NULL — partial-unique
/// сырым SQL в миграции (Budget_workspaceId_categoryId_active_key), НЕ в схеме
/// (см. грабли drift в CLAUDE.md).
model Budget {
  id          String  @id @default(cuid())
  workspaceId String
  categoryId  String
  /// Месячный лимит (EXPENSE-категория) или план (INCOME).
  amount      Decimal @db.Decimal(14, 2)
  note        String?

  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category  @relation("BudgetCategory", fields: [categoryId], references: [id])
  createdBy User      @relation("BudgetCreatedBy", fields: [createdById], references: [id])

  @@index([workspaceId, deletedAt])
}
