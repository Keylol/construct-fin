# Скопировать в /srv/construct-v6/.env.production и заполнить.

# Postgres
POSTGRES_USER=construct
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=construct_v6

# API
JWT_SECRET=change-me-64-random-chars
TELEGRAM_BOT_TOKEN=token-from-/srv/construct/app/.env
TELEGRAM_ALLOWED_IDS=661916730,932026723
PUBLIC_ORIGIN=https://miniapp.aleksandrantropov.online
MAX_UPLOAD_SIZE_MB=10

# Images (overridden by CI when pushing new tags)
API_IMAGE=ghcr.io/keylol/construct-v6-api:latest
WEB_IMAGE=ghcr.io/keylol/construct-v6-web:latest
