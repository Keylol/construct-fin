# Скопировать в /srv/construct-v6/.env.production и заполнить.

# Postgres
POSTGRES_USER=construct
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=construct_v6

# API
JWT_SECRET=change-me-64-random-chars
TELEGRAM_BOT_TOKEN=token-from-/srv/construct-v6/.env.production
TELEGRAM_ALLOWED_IDS=661916730,932026723
PUBLIC_ORIGIN=https://miniapp.aleksandrantropov.online
MAX_UPLOAD_SIZE_MB=10
# Ф1 «Полный автомат»: мастер-ключ шифрования токенов интеграций (банки/WB).
# Сгенерировать: openssl rand -base64 32. Не задан → модуль интеграций выключен.
INTEGRATION_MASTER_KEY=generate-with-openssl-rand-base64-32
# L5-хвост: chat_id владельца для Telegram-алертов о 5xx (не задан → выключено).
# ALERT_TELEGRAM_CHAT_ID=

# Ф2 «Альфа-Бизнес API». Секрет подключения (API Key) хранится в БД зашифрованным
# и задаётся в UI, здесь — только адрес API и клиентский сертификат mTLS.
# Каталог с сертификатами монтируется в контейнер как /app/certs (только чтение).
# Не заданы → адаптер Альфы выключен, подключения отвечают 503.
#
# Песочница: https://sandbox.alfabank.ru/api/jp
# Пром:      https://baas.alfabank.ru/api/jp (значение по умолчанию)
# ALFA_API_BASE_URL=https://sandbox.alfabank.ru/api/jp
# ALFA_TLS_DIR=/srv/construct-v6/certs
# ALFA_TLS_CERT_PATH=/app/certs/sandbox_cert_2026.cer
# ALFA_TLS_KEY_PATH=/app/certs/sandbox_key_2026.key
# ALFA_TLS_CA_PATH=/app/certs/apica_2022_chain.cer
# ALFA_TLS_KEY_PASSPHRASE=

# Ф3 «Т-Банк». Сертификат не нужен: токен из ЛК Т-Бизнеса (Интеграции → Выпуск
# токена, доступ «Счета и выписки») вводится в UI и хранится в БД зашифрованным.
# Здесь — только адрес API.
# Песочница: https://business.tbank.ru/openapi/sandbox/api (токен TBankSandboxToken)
# Пром:      https://business.tbank.ru/openapi/api (значение по умолчанию)
# TBANK_API_BASE_URL=https://business.tbank.ru/openapi/sandbox/api

# Images (overridden by CI when pushing new tags)
API_IMAGE=ghcr.io/keylol/construct-v6-api:latest
WEB_IMAGE=ghcr.io/keylol/construct-v6-web:latest
