    "test:loadtest": "vitest run --config vitest.loadtest.config.ts"
  },
  "dependencies": {
    "@construct/db": "workspace:*",
    "@construct/shared": "workspace:*",
    "@fastify/cookie": "^9.4.0",
    "@fastify/multipart": "^8.3.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "csv-parse": "^6.2.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "exceljs": "^4.4.0",
    "fastify": "^4.29.0",
    "iconv-lite": "^0.7.2",
    "jschardet": "^3.1.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
